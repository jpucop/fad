# Python compiled files
*.pyc
*.pyo
*.pyd
__pycache__/
*.so

# Virtual environment
venv/
env/
.venv/
ENV/

# Dependency directories
node_modules/          # Root node_modules from package.json
.pip_cache/
pip-wheel-metadata/
dist/                 # General build output
build/                # General build output
*.egg-info/
*.egg

# Frontend build artifacts
frontend/dist/         # Frontend build output
frontend/node_modules/ # Optional, if frontend has its own node_modules (unlikely now)
frontend/src/alpine*.js # Keep if generated, but consider broader coverage

# FastAPI/Pydantic specific
*.cache

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover
nosetests.xml
junit-reports/

# IDE/Editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Environment variables
.env
.env.dev
.env.prod

# System files
.DS_Store
Thumbs.db

# Docker-related
Dockerfile.*          # Ignore generated Dockerfiles
*.dockerignore        # Ignore if used
__pycache__/Dockerfile  # Avoid confusion with cached Dockerfiles

package-lock.json

