    "cssnano": "7.0.7",
    "esbuild": "0.25.5",
    "glob": "^11.0.0",
    "postcss": "8.5.6",
    "rimraf": "6.0.1",
    "serve": "14.2.4",
    "svgo": "4.0.0",
    "tailwindcss": "4.1.11"
