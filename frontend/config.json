{
  "paths": {
    "src": "./src",
    "dist": "./dist",
    "deploy": "../backend/app/static",
    "node_modules": "./node_modules",
    "mainHtml": "index.html"
  },
  "patterns": {
    "html": "**/*.html",
    "css": "**/*.css",
    "js": "**/*.js",
    "static": "**/*.{ico,png,jpg,jpeg,gif,webp,avif,woff,woff2,json}"
  },
  "sprite": {
    "filename": "sprite.svg",
    "containerElement": "span",
    "containerClass": "icon",
    "svgTemplate": "<svg class=\"icon-inner\"><use href=\"/{filename}#{iconClass}\"></use></svg>",
    "symbol": "<symbol\\s+id=\"([^\"]+)\""
  },
  "css": {
    "filename": "styles.css",
    "tailwindcss": {
      "darkMode": "class",
      "theme": { "extend": {} },
      "plugins": []
    }
  },
  "js": {
    "filename": "app.js",
    "alpine": {
      "dev_source": "alpinejs/dist/cdn.js",
      "minified_source": "alpinejs/dist/cdn.min.js"
    }
  }
}