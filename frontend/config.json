{
  "paths": {
    "src": "./src",
    "dist": "./dist",
    "deploy": "../backend/app/static",
    "node_modules": "./node_modules",
    "mainHtml": "index.html",
    "files": {
      "css": [
        "**/*.css"
      ],
      "html": [
        "index.html"
      ],
      "js": [
        "**/*.js"
      ]
    }
  },
  "sprite": {
    "filename": "sprite.svg",
    "scan": "<span\\s+[^>]*class=\"[^\"]*icon[^\"]*\"[^>]*>",
    "class": "(?:i-[a-z0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*|l-[a-z0-9-]+)(?=\\b|$)",
    "validate": "^(i-[a-z0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*|l-[a-z0-9-]+)$",
    "symbol": "<symbol\\s+id=\"([^\"]+)\"",
    "icon_svg": {}
  },
  "css": {
    "filename": "styles.css",
    "tailwindcss": {
      "darkMode": "class",
      "theme": {
        "extend": {}
      },
      "plugins": []
    }
  },
  "js": {
    "filename": "app.js",
    "alpine": {
      "dev_source": "alpinejs/dist/cdn.js",
      "minified_source": "alpinejs/dist/cdn.min.js",
      "output": "alpine.js"
    }
  }
}