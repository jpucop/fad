{
  "paths": {
    "src": "./src",
    "dist": "./dist",
    "deploy": "../app/static",
    "node_modules": "./node_modules",
    "index": "index.html"
  },
  "sprite": {
    "filename": "sprite.svg",
    "scan": "<span\\s+[^>]*class=\"[^\"]*icon[^\"]*\"[^>]*>",
    "class": "(?:i-[a-z0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*|l-[a-z0-9-]+)(?=\\b|$)",
    "validate": "^(i-[a-z0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*|l-[a-z0-9-]+)$",
    "symbol": "<symbol\\s+id=\"([^\"]+)\"",
    "icon_svg": {

    }
  },
  "js": {
    "bundle": false,
    "alpine": {
      "nodeModulePath": "alpinejs/dist/cdn.js",
      "nodeModulePathMin": "alpinejs/dist/cdn.min.js"
    }
  },
  "css": {
    "tailwindcss": {
      
    } 
  }
}