{
  "apps": [
    "csg",
    "rems",
    "wage",
    "itf"
  ],
  "defaults": {
    "app": {
      "name": "{name}",
      "short_name": "{name}",
      "long_name": "{name} Application",
      "description": "Managed FinApps app - {name}",
      "org": "ucop",
      "group": "finapps",
      "app_profile": "tomcat-java",
      "deploy_profile": "aws-cicd-fargate-rds",
      "source": {
        "project_name": "{name}Web",
        "git_origin_url": "https://git-codecommit.us-west-2.amazonaws.com/v1/repos/{project_name}",
        "production_branch_name": "main",
        "aws": {
          "account_name": "finapps-dev"
        }
      },
      "dbs": [
        {
          "name": "{name}_db",
          "server_name": "{name}_server",
          "host": "aws",
          "aws": {
            "account_name": "finapps-dev",
            "db_arn": "arn:aws:rds:us-west-2:{aws.account_id}:db:{db.name}"
          }
        }
      ],
      "confluence": {
        "group_web_url": "https://ucopedu.atlassian.net/wiki/spaces/FA/overview",
        "space_keys": ["FA"]
      },
      "box": {
        "group_web_url": "https://ucop.app.box.com/FA/"
      },
      "jira": {
        "project_keys": ["FA", "{name}"],
        "group_web_url": "https://ucopedu.atlassian.net/jira/FA/"
      },
      "service_now": {
        "group_web_url": "https://ucop.service-now.com/now/nav/ui/classic/params/target/%24pa_dashboard.do",
        "assignment_group_names": []
      },
      "datadog": {
        "group_web_url": "https://dd.com/ucop/finapps/index.html"
      },
      "environments": [
        {
          "env": "dev",
          "name": "development",
          "host": "aws",
          "app_profile": "tomcat-java",
          "deploy_profile": "aws-cicd-fargate-rds",
          "deploy_pipeline_name": "{name}-dev-pipeline",
          "git_branch_name": "dev",
          "aws": {
            "account_name": "finapps-dev"
          }
        },
        {
          "env": "qa",
          "name": "staging",
          "host": "aws",
          "app_profile": "tomcat-java",
          "deploy_profile": "aws-cicd-fargate-rds",
          "deploy_pipeline_name": "{name}-qa-pipeline",
          "git_branch_name": "qa",
          "aws": {
            "account_name": "finapps-dev"
          }
        },
        {
          "env": "prod",
          "name": "production",
          "host": "aws",
          "app_profile": "tomcat-java",
          "deploy_profile": "aws-cicd-fargate-rds",
          "deploy_pipeline_name": "{name}-prod-pipeline",
          "git_branch_name": "main",
          "aws": {
            "account_name": "finapps-prod"
          }
        }
      ]
    }
  }
}